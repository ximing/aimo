{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIMO",
  "version": "0.9.10",
  "identifier": "com.aimo.app",
  "build": {
    "beforeDevCommand": "node scripts/before-dev.mjs",
    "devUrl": "http://localhost:5173",
    "frontendDist": "https://aimo.plus"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "AIMO",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
