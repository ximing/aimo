# ===== AIMO Docker 部署配置 =====
# 使用方法：
#   curl -o .env https://raw.githubusercontent.com/ximing/aimo/master/.env.docker.example
#   然后修改下面两项必需配置，执行 docker compose up -d
#
# 必需配置（只有这两项必须修改）：
#   1. JWT_SECRET     —— JWT 密钥，至少 32 字符，随机生成：openssl rand -base64 32
#   2. OPENAI_API_KEY —— OpenAI API Key，用于语义搜索等 AI 功能

# ===== JWT 配置（必需） =====
JWT_SECRET=please-change-this-to-a-random-string

# ===== OpenAI 配置（必需，用于语义搜索） =====
OPENAI_API_KEY=sk-xxx
# 也可使用兼容 OpenAI 接口的第三方服务
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=text-embedding-3-small

# ===== MySQL 数据库配置 =====
# 无需修改：docker-compose.yml 已内置 MySQL 容器并自动配置连接。
# 如需自定义密码，请同时修改 docker-compose.yml 中 mysql 服务的配置。
# MYSQL_PASSWORD=aimo_password
# MYSQL_DATABASE=aimo

# ===== 附件存储配置 =====
# 默认存储在宿主机 ./data/attachments 目录
# ATTACHMENT_STORAGE_TYPE=local
# ATTACHMENT_MAX_FILE_SIZE=52428800

# ===== 多模态 Embedding 配置（图片/视频，可选） =====
# MULTIMODAL_EMBEDDING_ENABLED=false
# DASHSCOPE_API_KEY=your-dashscope-api-key

# ===== OCR 配置（可选） =====
# OCR_ENABLED=true
# ZHIPU_API_KEY=your-zhipu-api-key

# ===== 用户注册配置 =====
# 建议注册完自己的账号后改为 false 并重启（docker compose up -d）
ALLOW_REGISTRATION=true

# ===== 本地化配置 =====
LOCALE_LANGUAGE=zh-cn
LOCALE_TIMEZONE=Asia/Shanghai
